# ==============================================================================
# Crowd Management System (CMS) — Frontend Environment Configuration
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# Any environment variable prefixed with `VITE_` is statically embedded into
# the client-side JavaScript bundle during the build step.
#
# DO NOT store secrets, API private keys, administrative credentials, or
# sensitive certificates in this file or any .env file in this repository.
# Vite client-side variables are PUBLIC and accessible to anyone inspecting
# the browser network tab or JavaScript bundles.
# ==============================================================================

# Required: Base URL for CMS backend REST API
# Example (Local): http://localhost:8080/api
# Example (Production): https://api.yourdomain.com/api
# Default for development sandbox: https://hiring-dev.internal.kloudspot.com/api
VITE_BASE_URL=https://hiring-dev.internal.kloudspot.com/api

# Optional: Realtime Socket.IO Server URL (if different from REST API origin)
# If omitted, defaults to the origin of VITE_BASE_URL
# VITE_SOCKET_URL=https://hiring-dev.internal.kloudspot.com
